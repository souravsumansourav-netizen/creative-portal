# Frontend (public)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# R2 secrets live ONLY in Supabase Edge Function secrets, never in the frontend:
#   supabase secrets set R2_ACCOUNT_ID=... R2_ACCESS_KEY_ID=... R2_SECRET_ACCESS_KEY=... \
#     R2_BUCKET=creative-assets R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
